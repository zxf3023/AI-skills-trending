# Line-ending policy: LF inside the repository, converted on checkout by file type.
# Purpose: run_report.bat must come out CRLF on any machine that clones this repo.
# Background: cmd.exe mis-parses an LF-only batch file and executes `rem` comments
# as commands, which once produced "'launcher' is not recognized as an internal or
# external command" after the folder was copied to another machine.
* text=auto

*.bat  text eol=crlf
*.txt  text eol=crlf
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Keep the repository's own config files LF as well, so `git add` never warns
.gitattributes text eol=lf
.gitignore     text eol=lf
